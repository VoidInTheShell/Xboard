# The default Compose template requires exact published image tags.
# Uncomment and replace these values in the deployment copy of .env.
# XBOARD_DEPLOY_DIR=/opt/xboard
# XBOARD_VERSION=vX.Y.Z
# XBOARD_ADMIN_VERSION=vA.B.C
# XBOARD_UPDATER_VERSION=vA.B.C
# XBOARD_PANEL_URL=https://panel.example.com
# XBOARD_ADMIN_PORT=7003
# XBOARD_PORT=7001
APP_NAME=XBoard
APP_ENV=production
APP_KEY=base64:PZXk5vTuTinfeEVG5FpYv2l6WEhLsyvGpiWK7IgJJ60=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xboard
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME=null
MAILGUN_DOMAIN=
MAILGUN_SECRET=

# google cloud storage
ENABLE_AUTO_BACKUP_AND_UPDATE=false
GOOGLE_CLOUD_KEY_FILE=config/googleCloudStorageKey.json
GOOGLE_CLOUD_STORAGE_BUCKET=

# Prevent reinstallation
INSTALLED=false

# Optional observation ledger (apply migrations before enabling).
# Also configurable via authenticated admin/MCP usage/settings/save.
USAGE_ENABLED=false
USAGE_HISTORY_DAYS=400
USAGE_ACCESS_DAYS=90
USAGE_IDENTITY_DAYS=400
